{
  "name": "package-tracker/package-tracker",
  "type": "project",
  "description": "Laravel package tracking system V1",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/breeze": "^2.3",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"]},
  "minimum-stability": "stable",
  "prefer-stable": true
}
